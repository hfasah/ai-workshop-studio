{
  "name": "ai-workshop-studio",
  "version": "1.0.0",
  "description": "AI Workshop Studio: turn a topic into a short animated lesson (script, voice, captions, render) with a web UI and a local model",
  "repository": {
    "type": "git",
    "url": "https://github.com/hfasah/ai-workshop-studio"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/captions": "^4.0.520",
    "@remotion/cli": "4.0.520",
    "@remotion/google-fonts": "^4.0.520",
    "@remotion/media": "^4.0.520",
    "@remotion/media-utils": "^4.0.520",
    "@remotion/transitions": "^4.0.520",
    "lucide-react": "^1.41.0",
    "msedge-tts": "^2.0.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.520"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.520",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "script": "node scripts/script.mjs",
    "voice": "node scripts/voice.mjs",
    "render": "node scripts/render.mjs",
    "make": "node scripts/make.mjs",
    "lint": "eslint src && tsc",
    "api": "node scripts/api.mjs",
    "studio": "npm --prefix studio run dev",
    "studio:build": "npm --prefix studio run build",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/setup.mjs --check",
    "start": "node scripts/start.mjs"
  },
  "sideEffects": [
    "*.css"
  ]
}
