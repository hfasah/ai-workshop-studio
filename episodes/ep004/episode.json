      "onScreen": {
        "text": "An AI agent can answer questions about your business.",
        "emphasis": "But it needs an API to do that."
      },
      "lines": [
        {
          "speaker": "tanyi",
          "text": "Imagine you have a chatbot for customer service. It can answer basic questions, but it doesn't know anything specific about your company's products or services.",
          "expression": "confident",
          "gesture": "explain"
        },
        {
          "speaker": "tanyi",
          "text": "But what if you could make it smarter? What if it could answer detailed questions and even help with tasks?",
          "expression": "serious",
          "gesture": "point_right"
        }
      ]
    },
    {
