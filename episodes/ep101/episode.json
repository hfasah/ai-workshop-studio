      "lines": [
        {
          "speaker": "gatekeeper",
          "text": "Wouri Express owns its messages and its results. No driver is named in a blame line. Mbella reads every summary before she acts.",
          "expression": "serious",
          "gesture": "point_left"
        },
        {
          "speaker": "tanyi",
          "text": "That is artificial intelligence: software that learned patterns, reading what your people already write, with a person deciding.",
          "expression": "confident",
          "gesture": "explain"
        }
      ]
